{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": false,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"useDefineForClassFields": true,
		"verbatimModuleSyntax": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@shared/*": ["../shared/*"]
		}
	},
	"include": ["src", "../shared"]
}
