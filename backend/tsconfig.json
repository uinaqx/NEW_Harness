{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["bun"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": false,
		"noEmit": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"lib": ["ESNext", "DOM"],
		"baseUrl": ".",
		"paths": {
			"@shared/*": ["../shared/*"]
		}
	},
	"include": ["src", "../shared"]
}
